{
    "model_type": "comba",
    "attn_mode": "chunk",
    "hidden_size": 1024,
    "num_heads": 8,
    "head_dim": 128,
    "expand_v": 1.0,
    "num_hidden_layers": 24,
    "hidden_ratio": 4,
    "use_output_gate": false,
    "use_short_conv": true,
    "conv_size": 4,
    "use_output_correction": true,
    "use_inner_decay": true,
    "fuse_norm": true,
    "fuse_swiglu": true,
    "fuse_cross_entropy": true,
    "vocab_size": 32000,
    "bos_token_id": 1,
    "eos_token_id": 2,
    "tie_word_embeddings": true,
    "initializer_range": 0.02,
    "norm_eps": 1e-6
}
