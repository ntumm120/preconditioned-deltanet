{
    "model_type": "precond_deltanet",
    "attn_mode": "chunk",
    "hidden_size": 1024,
    "num_heads": 6,
    "head_dim": 256,
    "expand_v": 2,
    "num_hidden_layers": 21,
    "hidden_ratio": 4,
    "use_short_conv": true,
    "conv_size": 4,
    "fuse_norm": true,
    "fuse_swiglu": true,
    "fuse_cross_entropy": true,
    "vocab_size": 32000,
    "bos_token_id": 1,
    "eos_token_id": 2,
    "tie_word_embeddings": false,
    "initializer_range": 0.02,
    "norm_eps": 1e-6,
    "qk_norm": true,
    "use_gate": true,
    "precond_mode": "symmetric",
    "squash_type": "fast",
    "squash_x": 1.5,
    "learn_scale": true,
    "learn_gain": false,
    "log_A_scale_init": -0.2,
    "use_m_norm": true,
    "curvature_aware_m_norm": false
}
