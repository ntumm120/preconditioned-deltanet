{
  "allow_neg_eigval": false,
  "architectures": [
    "KDAForCausalLM"
  ],
  "attn": null,
  "attn_mode": "chunk",
  "bos_token_id": 1,
  "conv_size": 4,
  "dtype": "float32",
  "eos_token_id": 2,
  "expand_v": 1.0,
  "fuse_cross_entropy": true,
  "fuse_norm": true,
  "fuse_swiglu": true,
  "head_dim": 128,
  "hidden_act": "swish",
  "hidden_ratio": 4,
  "hidden_size": 1024,
  "initializer_range": 0.02,
  "intermediate_size": null,
  "max_position_embeddings": 2048,
  "model_type": "kda",
  "norm_eps": 1e-06,
  "num_heads": 8,
  "num_hidden_layers": 24,
  "num_v_heads": null,
  "tie_word_embeddings": true,
  "use_cache": true,
  "use_l2warp": false,
  "use_short_conv": true,
  "vocab_size": 32000
}
