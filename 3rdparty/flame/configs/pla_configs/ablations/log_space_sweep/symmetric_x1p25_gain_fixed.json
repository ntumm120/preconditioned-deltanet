{
    "model_type": "precond_gated_deltanet",
    "attn_mode": "chunk",
    "hidden_size": 1024,
    "num_heads": 8,
    "head_dim": 128,
    "expand_v": 1.0,
    "num_hidden_layers": 24,
    "hidden_ratio": 4,
    "use_gate": false,
    "use_short_conv": true,
    "conv_size": 4,
    "fuse_norm": true,
    "fuse_swiglu": true,
    "fuse_cross_entropy": true,
    "vocab_size": 32000,
    "bos_token_id": 1,
    "eos_token_id": 2,
    "tie_word_embeddings": true,
    "initializer_range": 0.02,
    "norm_eps": 1e-06,
    "qk_norm": true,
    "k_precond_norm": true,
    "fix_r_one": true,
    "fixed_lambda": 0.1,
    "dt_bias_offset": 0.0,
    "untie": true,
    "precond_mode": "symmetric",
    "squash_type": "fast",
    "squash_x": 1.25,
    "squash_eps": 1e-06,
    "learn_scale": true,
    "learn_gain": false,
    "log_A_scale_init": -1.0,
    "use_m_norm": true
}
