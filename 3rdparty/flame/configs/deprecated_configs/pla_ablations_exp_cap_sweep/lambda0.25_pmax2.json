{
    "model_type": "precond_gated_deltanet",
    "attn_mode": "chunk",
    "hidden_size": 1024,
    "num_heads": 8,
    "head_dim": 128,
    "expand_v": 1.0,
    "num_hidden_layers": 24,
    "hidden_ratio": 4,
    "use_gate": false,
    "use_short_conv": true,
    "conv_size": 4,
    "fuse_norm": true,
    "fuse_swiglu": true,
    "fuse_cross_entropy": true,
    "vocab_size": 32000,
    "bos_token_id": 1,
    "eos_token_id": 2,
    "tie_word_embeddings": true,
    "initializer_range": 0.02,
    "norm_eps": 1e-06,
    "qk_norm": true,
    "k_precond_norm": true,
    "fix_r_one": false,
    "dt_bias_offset": 0.0,
    "fixed_lambda": 0.5,
    "untie": true,
    "max_atk_decay": 1.0,
    "learnable_lambda": true,
    "lambda_lower_bound": 0.25,
    "precond_soft_cap": 2.0
}
