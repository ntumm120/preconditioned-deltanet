{
  "model_type": "diag_online_net",
  "attn_mode": "chunk",
  "hidden_size": 1024,
  "num_heads": 8,
  "head_dim": 128,
  "expand_v": 1.0,
  "num_hidden_layers": 24,
  "hidden_ratio": 4,
  "use_gate": false,
  "use_short_conv": true,
  "conv_size": 4,
  "fuse_norm": true,
  "fuse_swiglu": true,
  "fuse_cross_entropy": true,
  "vocab_size": 32000,
  "bos_token_id": 1,
  "eos_token_id": 2,
  "tie_word_embeddings": true,
  "initializer_range": 0.02,
  "norm_eps": 1e-06,
  "precond_mode": "atk",
  "qk_norm": true,
  "gate_type": "scalar_gdn",
  "use_m_norm": true,
  "dt_bias_offset_precond": 0.0,
  "ema_g": false,
  "fix_r_one": false,
  "normalize_k_precond": false,
  "fixed_lambda": 0.001
}